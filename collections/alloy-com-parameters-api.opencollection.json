{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alloy Bank Accounts Parameters API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Parameters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Workflow Parameters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.alloy.co/v1/parameters"
          },
          "docs": "Get Workflow Parameters"
        }
      ]
    }
  ],
  "bundled": true
}